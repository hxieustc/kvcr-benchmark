{
  "apiVersion": "v1",
  "kind": "PersistentVolumeClaim",
  "metadata": {
    "name": "kv-p2p-workspace",
    "namespace": "harryx-kv-egm"
  },
  "spec": {
    "accessModes": [
      "ReadWriteOnce"
    ],
    "storageClassName": "ebs",
    "resources": {
      "requests": {
        "storage": "512Gi"
      }
    }
  }
}

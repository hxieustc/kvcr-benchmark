{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "sglang-hicache-gb300-4gpu-20261103-r2",
    "namespace": "harryx-kv-egm",
    "labels": {
      "app": "sglang-hicache-parity",
      "owner": "harryx"
    },
    "annotations": {
      "gpu-reaper.nvidia.com/opt-out": "true",
      "benchmark-state": "preparing-hicache-kvcr-and-mooncake"
    }
  },
  "spec": {
    "automountServiceAccountToken": false,
    "containers": [
      {
        "command": [
          "sleep",
          "infinity"
        ],
        "env": [
          {
            "name": "POD_IP",
            "valueFrom": {
              "fieldRef": {
                "apiVersion": "v1",
                "fieldPath": "status.podIP"
              }
            }
          },
          {
            "name": "HF_HOME",
            "value": "/workspace/sglang-hicache-parity-20261103-r1/cache/huggingface"
          },
          {
            "name": "NIXL_UCX_SGL_ENABLE",
            "value": "1"
          },
          {
            "name": "UCX_MAX_RNDV_RAILS",
            "value": "1"
          },
          {
            "name": "PYTHONNOUSERSITE",
            "value": "1"
          },
          {
            "name": "PYTHONDONTWRITEBYTECODE",
            "value": "1"
          }
        ],
        "image": "lmsysorg/sglang:v0.5.21-cu130-runtime@sha256:417fc90dfa9392d0e62f3c0a586a297b6d75082eccc90e63905832ac58ae85ff",
        "imagePullPolicy": "IfNotPresent",
        "name": "main",
        "resources": {
          "claims": [
            {
              "name": "roce"
            }
          ],
          "limits": {
            "cpu": "48",
            "ephemeral-storage": "128Gi",
            "memory": "850Gi",
            "nvidia.com/gpu": "4"
          },
          "requests": {
            "cpu": "40",
            "ephemeral-storage": "64Gi",
            "memory": "850Gi",
            "nvidia.com/gpu": "4"
          }
        },
        "securityContext": {
          "capabilities": {
            "add": [
              "IPC_LOCK",
              "SYS_PTRACE",
              "SYS_RESOURCE"
            ]
          }
        },
        "terminationMessagePath": "/dev/termination-log",
        "terminationMessagePolicy": "File",
        "volumeMounts": [
          {
            "mountPath": "/workspace",
            "name": "workspace"
          },
          {
            "mountPath": "/models-shared",
            "name": "models",
            "readOnly": true
          },
          {
            "mountPath": "/dev/shm",
            "name": "shm"
          }
        ]
      }
    ],
    "imagePullSecrets": [
      {
        "name": "acr-token-secret"
      }
    ],
    "nodeSelector": {
      "kubernetes.io/hostname": "ip-100-64-187-192.us-east-2.compute.internal"
    },
    "resourceClaims": [
      {
        "name": "roce",
        "resourceClaimTemplateName": "sglang-kvcr-single-rnic"
      }
    ],
    "restartPolicy": "Never",
    "securityContext": {},
    "volumes": [
      {
        "name": "workspace",
        "persistentVolumeClaim": {
          "claimName": "kv-p2p-workspace"
        }
      },
      {
        "name": "models",
        "persistentVolumeClaim": {
          "claimName": "shared-model-cache"
        }
      },
      {
        "emptyDir": {
          "medium": "Memory",
          "sizeLimit": "16Gi"
        },
        "name": "shm"
      }
    ]
  }
}

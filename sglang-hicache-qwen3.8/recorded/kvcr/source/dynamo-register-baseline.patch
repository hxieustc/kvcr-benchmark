+def _cache_eagle_enabled_for(engine, speculative_algorithm) -> bool:
+    """Advertise actual cache keys; Mamba disables bigrams even with EAGLE."""
+    infos = getattr(getattr(engine, "_scheduler_init_result", None), "scheduler_infos", [])
+    modes = [info["cache_key_is_eagle"] for info in infos if "cache_key_is_eagle" in info]
+    if not modes:
+        return _eagle_enabled_for(speculative_algorithm)
+    if len(modes) != len(infos) or any(type(mode) is not bool for mode in modes) or any(mode != modes[0] for mode in modes):
+        raise ValueError("Scheduler cache key modes must be complete, boolean and consistent")
+    return modes[0]
+

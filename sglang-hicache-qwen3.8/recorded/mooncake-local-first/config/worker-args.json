{
  "model-path": "${VERIFIED_MODEL_PATH}",
  "served-model-name": "nvidia/Qwen3.8-Flash-Next-NVFP4",
  "attention-backend": "trtllm_mha",
  "chunked-prefill-size": "16384",
  "context-length": "262144",
  "cuda-graph-backend-decode": "full",
  "cuda-graph-backend-prefill": "disabled",
  "cuda-graph-bs-decode": [
    "1",
    "2",
    "4",
    "8",
    "16",
    "24",
    "32",
    "40",
    "48",
    "56",
    "64",
    "72",
    "80",
    "88",
    "96"
  ],
  "cuda-graph-max-bs-decode": "96",
  "data-parallel-size": "1",
  "decode-log-interval": "10",
  "disable-shared-experts-fusion": true,
  "enable-cache-report": true,
  "enable-linear-replayssm-spec": true,
  "enable-metrics": true,
  "expert-parallel-size": "1",
  "hicache-write-policy": "write_through",
  "kv-cache-dtype": "bfloat16",
  "linear-attn-decode-backend": "flashinfer",
  "linear-attn-prefill-backend": "flashinfer",
  "linear-attn-verify-backend": "triton",
  "mamba-radix-cache-strategy": "extra_buffer_lazy",
  "mamba-ssm-dtype": "bfloat16",
  "mamba-track-interval": "256",
  "max-mamba-cache-size": "480",
  "max-prefill-tokens": "16384",
  "max-running-requests": "96",
  "mem-fraction-static": "0.88",
  "moe-a2a-backend": "none",
  "moe-runner-backend": "flashinfer_trtllm",
  "page-size": "64",
  "pipeline-parallel-size": "1",
  "ple-offload-backend": "pinned",
  "ple-offload-embedding": true,
  "quantization": "modelopt_mixed",
  "random-seed": "35",
  "reasoning-parser": "auto",
  "revision": "fc694b54fb0174e0913e6adf86691ef85a4ead47",
  "scheduler-recv-interval": "1",
  "speculative-algorithm": "NEXTN",
  "speculative-draft-kv-cache-dtype": "bfloat16",
  "speculative-draft-model-revision": "fc694b54fb0174e0913e6adf86691ef85a4ead47",
  "speculative-eagle-topk": "1",
  "speculative-moe-runner-backend": "flashinfer_trtllm",
  "speculative-num-draft-tokens": "4",
  "speculative-num-steps": "3",
  "stream-interval": "20",
  "tensor-parallel-size": "1",
  "tokenizer-worker-num": "1",
  "trust-remote-code": true,
  "watchdog-timeout": "1800",
  "host": "127.0.0.1",
  "port": "${WORKER_HTTP_PORT}",
  "incremental-streaming-output": true,
  "kv-events-config": "${WORKER_KV_EVENTS_JSON}",
  "enable-hierarchical-cache": true,
  "hicache-host-memory-mode": "cache",
  "hicache-size": "27.487790694",
  "hicache-storage-prefetch-policy": "wait_complete",
  "hicache-mem-layout": "page_first_direct",
  "hicache-io-backend": "direct",
  "hicache-storage-backend": "mooncake",
  "hicache-storage-backend-extra-config": "${WORKER_STORAGE_JSON}"
}
